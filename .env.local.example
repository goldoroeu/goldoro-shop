# Supabase (Settings -> API в твоя Supabase проект)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=
# Stripe (Developers -> Webhooks -> твоят endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=

# Админ панел
ADMIN_PASSWORD=
# Произволен дълъг таен низ, различен от паролата (напр. изход на: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# Публичният адрес на сайта (в продукция: https://твоя-домейн.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
